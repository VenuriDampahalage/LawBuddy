# Copy to .env and fill in. Never commit .env.

# --- OpenAI ---
OPENAI_API_KEY=
CHAT_MODEL=gpt-6-luna
# Reasoning effort per step: none | low | medium | high (empty = model default).
# ANSWER_EFFORT= (default) gives slightly more thorough answers, ~2.8s slower to the first word.
PLAN_EFFORT=low
SELECT_EFFORT=none
ANSWER_EFFORT=low
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- LlamaParse (LlamaCloud) ---
LLAMA_CLOUD_API_KEY=
# fast | cost_effective | agentic | agentic_plus
LLAMAPARSE_TIER=cost_effective

# --- Database (Postgres + pgvector) ---
DATABASE_URL=postgresql+psycopg://lawbuddy:lawbuddy@localhost:5432/lawbuddy

# --- Backend auth ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# e.g. 1234567890-abc123.apps.googleusercontent.com  (leave empty to hide the Google button)
GOOGLE_CLIENT_ID=

# --- Frontend ---
# The frontend's address(es), comma-separated: https://, no trailing slash. Websites allowed
# to call this API from the browser. Add the Vercel URL here (and in Vercel's env settings).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
