# Copy to .env. Vite builds these into the site, so never put secrets here.

# Required. The backend's address (no /api needed). The backend must allow this site in its
# CORS_ORIGINS. Local development:
VITE_API_URL=http://localhost:8000
# Deployed: set it in the frontend project's environment variables on the host instead, e.g.
# VITE_API_URL=https://your-backend.vercel.app

# Optional. Shown as the contact address on the Privacy Policy and Terms pages.
VITE_CONTACT_EMAIL=
